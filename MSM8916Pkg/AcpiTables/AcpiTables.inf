[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = NintendoSwitchAcpiTables
  FILE_GUID                      = 7E374E25-8E01-4FEE-87F2-390C23C606CD # Must be this
  MODULE_TYPE                    = USER_DEFINED
  VERSION_STRING                 = 1.0

[Sources]
  # imbushuo (Bingxing Wang) / Ivaylo Ivanov soyundan EVRILMIS tablolarimizi KAYNAKTAN
  # derle (eskiden MTP8916 Windows binary'leri kullaniliyordu -> AcpiPlatform fail + bos DSDT).
  # Fadt'ta PSCI artik ACIK. DSDT wine asl.exe ile DSDT.AML'e derlenip asagida binary eklenir.
  Dbg2.aslc
  Facs.aslc
  Fadt.aslc
  Gtdt.aslc
  Madt.aslc

[Binaries.AARCH64]
  # MTP8916 (Windows) Gtdt/Madt/dbg2 binary'leri KALDIRILDI -> artik kaynaktan deriliyor
  # (yoksa cift MADT/GTDT/DBG2 olusurdu). Sadece DSDT wine ile derlenip buradan ekleniyor.
  ASL|MSM8916Pkg/AcpiTables/DSDT.AML

  #ASL|MSM8916Pkg/PreBuiltAcpis/dsdt.aml
  #ASL|MSM8916Pkg/MTP8916Acpis/bgrt.acpi
 
  # ASL|MSM8916Pkg/MTP8916Acpis/Facp.acpi
  #ASL|MSM8916Pkg/MTP8916Acpis/TPM2.acpi
  #ASL|MSM8916Pkg/MTP8916Acpis/Csrt.acpi
  #ASL|MSM8916Pkg/MTP8916Acpis/Dsdt.aml
  #ASL|MSM8916Pkg/MTP8916Acpis/Facs.acpi
  #ASL|MSM8916Pkg/MTP8916Acpis/Fpdt.acpi

[Packages]
  ArmPkg/ArmPkg.dec
  ArmPlatformPkg/ArmPlatformPkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  MSM8916Pkg/MSM8916Pkg.dec

[BuildOptions.AARCH64]
  GCC:*_*_*_CC_FLAGS = -Wno-error=missing-braces

[FixedPcd]
  gArmPlatformTokenSpaceGuid.PcdCoreCount
  gArmTokenSpaceGuid.PcdGicDistributorBase
  gArmTokenSpaceGuid.PcdGicInterruptInterfaceBase

  gArmTokenSpaceGuid.PcdArmArchTimerSecIntrNum
  gArmTokenSpaceGuid.PcdArmArchTimerIntrNum
  gArmTokenSpaceGuid.PcdArmArchTimerHypIntrNum
  gArmTokenSpaceGuid.PcdArmArchTimerVirtIntrNum
